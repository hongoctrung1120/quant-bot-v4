# Copy to .env and fill in values. NEVER commit .env to version control.

# Trading mode override (optional)
# MODE=BACKTEST

# Exchange API credentials (Phase 18+)
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BYBIT_API_KEY=
# BYBIT_API_SECRET=

# Database (optional production)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=quant_bot
# POSTGRES_USER=
# POSTGRES_PASSWORD=

# Redis (optional production)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Telegram alerts (Phase 15+)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
